# Skopiuj ten plik do `.env`, a następnie załaduj go do bieżącej powłoki:
#   set -a; source .env; set +a
# Skrypty nie wczytują `.env` automatycznie. W pliku przechowuj wyłącznie
# konfigurację; właściwe klucze API pozostają w plikach poza repozytorium.

secret_root="${XDG_CONFIG_HOME:-$HOME/.config}/nixos-config/secrets"
GEMINI_API_KEY_FILE="$secret_root/gemini-wallpapers.key"
ARK_API_KEY_FILE="$secret_root/byteplus-wallpapers.key"
BFL_API_KEY_FILE="$secret_root/bfl-wallpapers.key"

# Produkcyjne ustawienia generatorów; zmieniaj je tylko dla świadomego testu
# innego modelu, formatu albo regionu API.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
WALLPAPER_ASPECT_RATIO=4:1
WALLPAPER_IMAGE_SIZE=4K

SEEDREAM_MODEL=seedream-5-0-lite-260128
SEEDREAM_WALLPAPER_SIZE=5120x1440
ARK_IMAGE_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3/images/generations

FLUX_WALLPAPER_WIDTH=3584
FLUX_WALLPAPER_HEIGHT=1008
BFL_API_ENDPOINT=https://api.bfl.ai/v1/flux-2-max

# 0 chroni istniejące, płatne wyniki przed przypadkowym zastąpieniem.
WALLPAPER_OVERWRITE=0

# Opcjonalne ustawienia masteringu. Puste MAGICK_BIN używa programu z PATH.
OLED_BLACK_TARGET=35
OLED_MAX_BLACK_POINT=10
MAGICK_BIN=
