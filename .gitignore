# Nix build outputs
/result
/result-*

# Local development state
/.direnv/
# Keep Codex runtime state local, but version the repository management skill.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/manage-nixos-config/
!/.agents/skills/manage-nixos-config/**
/.codex/
.env
.env.*
!.env.example

# Host configurations explicitly approved for versioning
/hosts/*/
!/hosts/rog-polamaniec/
!/hosts/rog-polamaniec/**

# User home configurations explicitly approved for versioning
/home/*/
!/home/wojtek/
!/home/wojtek/**

# Large local machine and installation images
*.img
*.iso
*.qcow2

# Generated benchmark runs contain mutable machine state and can grow to
# multiple gigabytes. Keep only the methodology and directory documentation.
/docs/benchmark-results/*
!/docs/benchmark-results/README.md

# Paid-generation review intermediates stay local. Accepted source masters,
# prompts, metrics and final aspect-ratio variants remain versioned.
/home/wojtek/wallpapers/candidates/

# Editor and temporary files
*~
*.bak
*.swp
*.swo
.DS_Store
