# Nix build outputs
/result
/result-*

# Local development state
/.direnv/
# Keep Codex runtime state local, but version the repository management skill.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/manage-nixos-config/
!/.agents/skills/manage-nixos-config/**
!/.agents/skills/nixos-manager/
!/.agents/skills/nixos-manager/**
/.codex/
.env
.env.*
!.env.example

# Host configurations explicitly approved for versioning
/hosts/*/
!/hosts/rog-polamaniec/
!/hosts/rog-polamaniec/**
!/hosts/white-monster/
!/hosts/white-monster/**
!/hosts/izakomp/
!/hosts/izakomp/**
!/hosts/armaniec/
!/hosts/armaniec/**

# User home configurations explicitly approved for versioning
/home/*/
!/home/base/
!/home/base/**
!/home/izakomp/
!/home/izakomp/**
!/home/individual/
!/home/individual/wojtek/
!/home/individual/wojtek/override.nix
!/home/individual/izakomp/
!/home/individual/izakomp/override.nix

# Large local machine and installation images
*.img
*.iso
*.qcow2

# Generated benchmark runs contain mutable machine state and can grow to
# multiple gigabytes. Keep only the methodology and directory documentation.
/docs/benchmark-results/*
!/docs/benchmark-results/README.md

# Paid-generation review intermediates stay local. Keep the original 16:9 JPEG
# inputs versioned so upscale and later 32:9 outpaint can start from the same
# source files on every machine; other RAW formats and work products stay local.
/home/base/wallpapers/raw/*
!/home/base/wallpapers/raw/16x9/
/home/base/wallpapers/raw/16x9/*
!/home/base/wallpapers/raw/16x9/*.jpg
!/home/base/wallpapers/raw/16x9/*.jpeg
/home/base/wallpapers/work/
!/home/base/wallpapers/work/import-48/
!/home/base/wallpapers/work/import-48/masters/
!/home/base/wallpapers/work/import-48/masters/**

# Local npm experiment; the declarative Nix configuration does not consume it.
/node_modules/
/package.json
/package-lock.json

# Editor and temporary files
*~
*.bak
*.swp
*.swo
.DS_Store
